@model DeskFlow.Web.ViewModels.Admin.AdminUsersViewModel
@{ ViewData["Title"] = "Team access"; }
<div class="row justify-content-center"><div class="col-xl-10">
    <a asp-controller="Home" asp-action="Index" class="small text-muted text-decoration-none">← Home</a>
    <header class="mt-3 mb-4">
        <p class="eyebrow mb-2">ADMINISTRATION</p>
        <h1 class="h3 mb-1">Team access</h1>
        <p class="text-muted mb-0">Choose who can work in the IT team queue.</p>
    </header>

    @if (TempData["AdminUsersNotice"] is string notice) { <div class="alert alert-success" role="status">@notice</div> }
    @if (TempData["AdminUsersError"] is string error) { <div class="alert alert-warning" role="alert">@error</div> }

    <form method="get" asp-action="Index" class="admin-user-search mb-3">
        <label class="visually-hidden" for="search">Find an account</label>
        <input id="search" name="search" value="@Model.Search" maxlength="120" class="form-control" placeholder="Find someone by name or email" />
        <button class="btn btn-outline-secondary" type="submit">Search</button>
        @if (!string.IsNullOrWhiteSpace(Model.Search))
        {
            <a asp-action="Index" class="btn btn-link text-secondary">Clear</a>
        }
    </form>

    <p class="queue-summary small text-muted mb-2">
        @Model.TotalUsers account@(Model.TotalUsers == 1 ? "" : "s")
        @if (Model.TotalUsers > 0) { <span> · page @Model.Page of @Model.TotalPages</span> }
    </p>

    @if (Model.Users.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-mark">⌕</div>
            <h2 class="h5">No accounts found</h2>
            <p class="text-muted mb-0">Try a different name or email address.</p>
        </div>
    }
    else
    {
        <section class="admin-user-list" aria-label="Registered accounts">
        @foreach (var user in Model.Users)
        {
            <article class="admin-user-row">
                <div class="admin-user-identity">
                    <h2 class="h6 mb-1">@user.DisplayName</h2>
                    <p class="small text-muted mb-2">@user.Email</p>
                    <div class="admin-user-badges">
                        @if (user.IsAdministrator) { <span class="admin-role-badge">Administrator · protected</span> }
                        @if (user.Roles.Contains(DeskFlow.Web.Models.ApplicationRoles.EndUser)) { <span class="admin-role-badge">End User</span> }
                        @if (!user.IsAdministrator && !user.Roles.Contains(DeskFlow.Web.Models.ApplicationRoles.EndUser) && !user.IsTechnician && !user.IsHelpdeskManager)
                        {
                            <span class="text-muted small">No assigned roles</span>
                        }
                    </div>
                </div>
                <div class="admin-role-controls" aria-label="Staff roles for @user.DisplayName">
                    <form asp-action="UpdateRole" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="userId" value="@user.Id" />
                        <input type="hidden" name="role" value="@DeskFlow.Web.Models.ApplicationRoles.Technician" />
                        <input type="hidden" name="enabled" value="@(!user.IsTechnician)" />
                        <input type="hidden" name="search" value="@Model.Search" />
                        <input type="hidden" name="page" value="@Model.Page" />
                        <button class="btn @(user.IsTechnician ? "btn-outline-secondary" : "btn-outline-primary")" type="submit">
                            @(user.IsTechnician ? "Remove technician" : "Add technician")
                        </button>
                    </form>
                    <form asp-action="UpdateRole" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="userId" value="@user.Id" />
                        <input type="hidden" name="role" value="@DeskFlow.Web.Models.ApplicationRoles.HelpdeskManager" />
                        <input type="hidden" name="enabled" value="@(!user.IsHelpdeskManager)" />
                        <input type="hidden" name="search" value="@Model.Search" />
                        <input type="hidden" name="page" value="@Model.Page" />
                        <button class="btn @(user.IsHelpdeskManager ? "btn-outline-secondary" : "btn-outline-primary")" type="submit">
                            @(user.IsHelpdeskManager ? "Remove manager" : "Add manager")
                        </button>
                    </form>
                </div>
            </article>
        }
        </section>

        @if (Model.TotalPages > 1)
        {
            <nav class="d-flex justify-content-between align-items-center mt-3" aria-label="Account pages">
                @if (Model.Page > 1)
                {
                    <a asp-action="Index" asp-route-search="@Model.Search" asp-route-page="@(Model.Page - 1)" class="btn btn-outline-secondary">← Previous</a>
                }
                else { <span></span> }
                @if (Model.Page < Model.TotalPages)
                {
                    <a asp-action="Index" asp-route-search="@Model.Search" asp-route-page="@(Model.Page + 1)" class="btn btn-outline-secondary">Next →</a>
                }
            </nav>
        }
    }

    <p class="small text-muted mt-4 mb-0">Administrator membership is protected here. Staff role changes take effect after the account signs in again.</p>
</div></div>
