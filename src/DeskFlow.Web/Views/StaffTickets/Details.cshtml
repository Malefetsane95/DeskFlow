@model DeskFlow.Web.ViewModels.Staff.StaffTicketDetailViewModel
@{ ViewData["Title"] = Model.Reference + " · Team"; }
<div class="row justify-content-center"><div class="col-lg-9">
    <a asp-action="Index" class="small text-muted text-decoration-none">← Team queue</a>
    @if (TempData["StaffNotice"] is string notice) { <div class="alert alert-success mt-3" role="status">@notice</div> }
    @if (TempData["StaffError"] is string error) { <div class="alert alert-warning mt-3" role="alert">@error</div> }
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mt-3 mb-4"><div><p class="ticket-reference mb-2">@Model.Reference · @Model.Category</p><h1 class="h3 mb-1">@Model.Title</h1><p class="text-muted mb-0">Sent by @Model.Requester on @Model.CreatedAt.ToLocalTime().ToString("d MMM yyyy 'at' h:mm tt")</p></div><span class="status-pill status-pill-large">@Model.Status</span></div>
    <div class="row g-4">
        <div class="col-lg-8">
            <section class="ticket-card mb-4"><div class="d-flex justify-content-between gap-3"><h2 class="h6 mb-3">Request details</h2><span class="priority-mark priority-@Model.Priority.ToLowerInvariant()">@Model.Priority priority</span></div><p class="ticket-description mb-0">@Model.Description</p></section>
            <section class="ticket-card mb-4" aria-labelledby="sla-heading">
                <h2 id="sla-heading" class="h6 mb-1">Service targets</h2>
                <p class="text-muted small mb-3">Based on the @Model.Priority priority target and calendar hours.</p>
                <div class="sla-detail-list">
                    @foreach (var sla in new[] { Model.ResponseSla, Model.ResolutionSla })
                    {
                        <div class="sla-detail-row">
                            <div><strong>@sla.Name</strong>@if (sla.DueAt is DateTimeOffset dueAt) { <div class="small text-muted">Due @dueAt.ToLocalTime().ToString("d MMM yyyy 'at' h:mm tt")</div> }</div>
                            <div class="text-end"><span class="sla-state sla-@sla.StateClass">@sla.State</span><div class="small text-muted mt-1">@sla.Summary</div></div>
                        </div>
                    }
                </div>
            </section>
            <section class="ticket-card mb-4">
                <div class="d-flex justify-content-between align-items-baseline gap-3"><h2 class="h6 mb-3">Attachments</h2><span class="small text-muted">@Model.Attachments.Count of 5</span></div>
                @if (Model.Attachments.Count == 0) { <p class="text-muted small">No files attached yet.</p> }
                else
                {
                    <ul class="attachment-list">
                    @foreach (var attachment in Model.Attachments)
                    {
                        <li><a asp-controller="TicketAttachments" asp-action="Download" asp-route-ticketId="@Model.Id" asp-route-attachmentId="@attachment.Id" class="attachment-link"><span class="attachment-file-name">@attachment.FileName</span><span class="attachment-file-meta">@attachment.UploadedBy · @((attachment.SizeBytes / 1024.0).ToString("N0")) KB</span></a></li>
                    }
                    </ul>
                }
                @if (Model.Attachments.Count < 5)
                {
                    <form asp-controller="TicketAttachments" asp-action="Upload" asp-route-ticketId="@Model.Id" method="post" enctype="multipart/form-data" class="attachment-upload mt-3">
                        <label for="file" class="form-label">Add a file</label><input id="file" name="file" type="file" class="form-control" accept=".png,.jpg,.jpeg,.pdf,.txt,.log" required />
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-2"><span class="form-text">PNG, JPG, PDF, TXT, or LOG · up to 10 MB</span><button type="submit" class="btn btn-outline-primary btn-sm">Upload attachment</button></div>
                    </form>
                }
                else { <p class="small text-muted mb-0">This request has reached its five file limit.</p> }
            </section>
            <section class="ticket-card mb-4"><h2 class="h6 mb-3">Activity</h2>
                @if (Model.History.Count == 0) { <p class="text-muted mb-0">No activity has been recorded yet.</p> }
                else
                {
                    <ol class="timeline mb-0">
                    @foreach (var item in Model.History)
                    {
                        <li><span class="timeline-dot"></span><div><strong>@(item.EventType == "StatusChanged" ? "Status changed" : item.EventType)</strong>@if (!string.IsNullOrWhiteSpace(item.PreviousValue)) { <span> · @item.PreviousValue →</span> }@if (!string.IsNullOrWhiteSpace(item.NewValue)) { <span> @item.NewValue</span> }<div class="small text-muted">@item.Actor · @item.OccurredAt.ToLocalTime().ToString("d MMM yyyy 'at' h:mm tt")</div></div></li>
                    }
                    </ol>
                }
            </section>
            <section class="conversation-section">
                <h2 class="h5 mb-1">Conversation</h2><p class="text-muted small mb-3">Public replies are shared with the requester. Internal notes stay with the IT team.</p>
                @if (TempData["CommentNotice"] is string commentNotice) { <div class="alert alert-success" role="status">@commentNotice</div> }
                @if (Model.Conversation.Count == 0)
                {
                    <div class="conversation-empty">No one has replied yet.</div>
                }
                else
                {
                    <div class="conversation-list">
                    @foreach (var message in Model.Conversation)
                    {
                        <article class="conversation-message @(message.Visibility.StartsWith("Internal", StringComparison.Ordinal) ? "internal-note" : "")"><header><strong>@message.Author</strong><span class="conversation-visibility">@message.Visibility</span><time class="text-muted small ms-auto" datetime="@message.CreatedAt.ToString("O")">@message.CreatedAt.ToLocalTime().ToString("d MMM 'at' h:mm tt")</time></header><p class="mb-0 conversation-body">@message.Body</p></article>
                    }
                    </div>
                }
                <form asp-action="AddComment" asp-route-id="@Model.Id" method="post" class="conversation-composer mt-3">
                    <label for="Body" class="form-label">Write a reply or note</label>
                    <textarea id="Body" name="Body" class="form-control" rows="4" maxlength="4000" required placeholder="Add what you learned, what you tried, or the next step"></textarea>
                    <div class="row align-items-end g-2 mt-1"><div class="col-sm"><label for="Visibility" class="form-label small">Who can see this?</label><select id="Visibility" name="Visibility" class="form-select"><option value="Public">Public reply · requester can see</option><option value="Internal">Internal note · staff only</option></select></div><div class="col-sm-auto"><button class="btn btn-primary" type="submit">Add to conversation</button></div></div>
                </form>
            </section>
        </div>
        <aside class="col-lg-4">
            <section class="ticket-card mb-3"><h2 class="h6 mb-3">Requester</h2><p class="mb-1 fw-semibold">@Model.Requester</p><p class="small text-muted mb-1">@Model.RequesterEmail</p>@if (!string.IsNullOrWhiteSpace(Model.Department)) { <p class="small text-muted mb-0">@Model.Department</p> }</section>
            <section class="ticket-card mb-3"><h2 class="h6 mb-2">Assigned to</h2><p class="text-muted small">@(Model.Technician ?? "No technician yet")</p>
                @if (User.IsInRole(DeskFlow.Web.Models.ApplicationRoles.Technician) && Model.TechnicianId is null && Model.StatusCode is not ("RESOLVED" or "CLOSED"))
                {
                    <form asp-action="Claim" asp-route-id="@Model.Id" method="post"><button class="btn btn-outline-primary w-100" type="submit">I’ll take this</button></form>
                }
                @if (User.IsInRole(DeskFlow.Web.Models.ApplicationRoles.HelpdeskManager))
                {
                    <form asp-action="Assign" asp-route-id="@Model.Id" method="post" class="mt-3"><label class="form-label small" for="technicianId">Assign or reassign</label><select id="technicianId" name="technicianId" asp-items="Model.Technicians" class="form-select mb-2"><option value="">Choose a technician</option></select><button class="btn btn-outline-primary w-100" type="submit">Save assignment</button></form>
                }
            </section>
            <section class="ticket-card"><h2 class="h6 mb-3">Update status</h2><form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post"><label class="visually-hidden" for="statusId">New status</label><select id="statusId" name="statusId" asp-items="Model.Statuses" class="form-select mb-2"></select><button class="btn btn-primary w-100" type="submit">Save status</button></form></section>
        </aside>
    </div>
</div></div>
