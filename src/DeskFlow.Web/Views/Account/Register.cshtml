@model DeskFlow.Web.ViewModels.Account.RegisterViewModel
@{ ViewData["Title"] = "Create your account"; }
<div class="row justify-content-center"><div class="col-md-7 col-lg-6">
    <h1 class="h3 mb-2">Create your DeskFlow account</h1>
    <p class="text-muted mb-4">Tell us a little about yourself so the support team knows who needs help.</p>
    <form asp-action="Register" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <input asp-for="ReturnUrl" type="hidden" />
        <div class="mb-3"><label asp-for="DisplayName" class="form-label">Your name</label><input asp-for="DisplayName" class="form-control" autocomplete="name" /><span asp-validation-for="DisplayName" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="Email" class="form-label">Work email</label><input asp-for="Email" class="form-control" autocomplete="email" /><span asp-validation-for="Email" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="Department" class="form-label">Department <span class="text-muted">(optional)</span></label><input asp-for="Department" class="form-control" autocomplete="organization-title" /><span asp-validation-for="Department" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" autocomplete="new-password" /><span asp-validation-for="Password" class="text-danger"></span><div class="form-text">Use at least 12 characters, including a number, uppercase letter, and symbol.</div></div>
        <div class="mb-4"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div>
        <button type="submit" class="btn btn-primary">Create account</button>
        <p class="mt-3 mb-0">Already have an account? <a asp-action="Login">Sign in</a></p>
    </form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
